# Comma-separated channel login names to join, e.g. 'mychannel' or 'a,b,c'. Required.
TWITCH_CHANNELS=''

# Leave all auth values empty to connect anonymously (read-only: chat is
# forwarded to AIRI, but no replies can be sent back to Twitch chat).
TWITCH_CLIENT_ID=''
TWITCH_ACCESS_TOKEN=''

# Provide these two in addition to TWITCH_CLIENT_ID to enable self-refreshing
# tokens for long-running sessions (recommended for streams longer than ~4h).
TWITCH_CLIENT_SECRET=''
TWITCH_REFRESH_TOKEN=''

# Bot account login name. Used to ignore the bot's own messages and to detect
# mentions. Required when TWITCH_MENTION_ONLY is 'true'.
TWITCH_BOT_USERNAME=''

# 'true' to only forward messages that mention @TWITCH_BOT_USERNAME.
TWITCH_MENTION_ONLY=''

# 'false' to also forward messages starting with '!' (bot commands). Default: 'true'.
TWITCH_IGNORE_COMMANDS=''

# 'false' to never reply in Twitch chat (AIRI still speaks responses on stage).
# Defaults to 'true' when authenticated, always 'false' when anonymous.
TWITCH_REPLY_IN_CHAT=''

AIRI_TOKEN=''
AIRI_URL=''
